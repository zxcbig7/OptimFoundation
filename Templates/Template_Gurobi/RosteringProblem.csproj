<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptimFoundation.Core\OptimFoundation.Core.csproj" />
    <ProjectReference Include="..\..\src\OptimFoundation.Gurobi\OptimFoundation.Gurobi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Gurobi110.NET"
               Condition="Exists('$(GUROBI_HOME)\bin\Gurobi110.NET.dll')">
      <HintPath>$(GUROBI_HOME)\bin\Gurobi110.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
