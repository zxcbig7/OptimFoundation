<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>OptimFoundation.Generators</AssemblyName>
    <RootNamespace>OptimFoundation.Generators</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- RS2008（analyzer release tracking）只對發佈成 NuGet 的 analyzer 有意義，內部 generator 不需要 -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 與 Core 共用同一份 Variable 前綴判型規則，避免 Generator 與執行期漂移。 -->
  <ItemGroup>
    <Compile Include="..\OptimFoundation.Core\VariablePrefixNaming.cs" Link="VariablePrefixNaming.cs" />
  </ItemGroup>

</Project>
