<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>OptimFoundation.Generators</AssemblyName>
    <RootNamespace>OptimFoundation.Generators</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- 內部 generator 不做 NuGet analyzer release tracking。 -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- 與 Core 共用變數前綴規則，確保編譯時與執行時判定一致。 -->
  <ItemGroup>
    <Compile Include="..\OptimFoundation.Core\VariablePrefixNaming.cs" Link="VariablePrefixNaming.cs" />
  </ItemGroup>

</Project>
