<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OptimFoundation.Cplex</AssemblyName>
    <RootNamespace>OptimFoundation.Cplex</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 供引用 DLL 的專案顯示 IntelliSense。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CplexDir Condition="'$(CplexDir)' == ''">C:\IBM\ILOG\CPLEX_Studio2211</CplexDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OptimFoundation.Core\OptimFoundation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ILOG.Concert">
      <HintPath>$(CplexDir)\cplex\bin\x64_win64\ILOG.Concert.dll</HintPath>
    </Reference>
    <Reference Include="ILOG.CPLEX">
      <HintPath>$(CplexDir)\cplex\bin\x64_win64\ILOG.CPLEX.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
